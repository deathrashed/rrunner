module github.com/deathrashed/rrunner

go 1.22

// Enhanced version with comprehensive internal packages:
// - internal/config: Configuration management with validation
// - internal/actions: Action handlers and execution engine
// - internal/plugins: Advanced plugin system with hot-reload
// - internal/registry: Action and plugin registry management  
